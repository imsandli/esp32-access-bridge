root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.{kicad_sch,kicad_pcb,kicad_sym,kicad_mod}]
# KiCad writes tabs; never reformat these files by hand
indent_style = tab
trim_trailing_whitespace = false

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
